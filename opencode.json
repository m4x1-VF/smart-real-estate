{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "baserow": {
      "pollInterval": 5000,
      "timeout": 300000,
      "enabled": false,
      "type": "remote",
      "url": "https://api.baserow.io/mcp/n61aELq85Q907M923P6wEG81Wxu0g9F3/sse"
    },
    "context7": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "engram": {
      "command": [
        "C:\\Users\\maxiv\\AppData\\Local\\engram\\bin\\engram.exe",
        "mcp",
        "--tools=agent"
      ],
      "type": "local"
    },
    "github": {
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "oauth": false,
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "supabase": {
      "enabled": false,
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp"
    },
    "open-design": {
      "enabled": false,
      "type": "local",
      "command": [
        "C:\\Users\\maxiv\\AppData\\Local\\Programs\\Open Design release-stable-win\\Open Design.exe",
        "C:\\Users\\maxiv\\AppData\\Local\\Programs\\Open Design release-stable-win\\resources\\app\\prebundled\\daemon\\daemon-cli.mjs",
        "mcp"
      ],
      "environment": {
        "OD_DATA_DIR": "C:\\Users\\maxiv\\AppData\\Roaming\\Open Design\\namespaces\\release-stable-win\\data",
        "OD_SIDECAR_IPC_PATH": "\\\\.\\pipe\\open-design-release-stable-win-daemon",
        "ELECTRON_RUN_AS_NODE": "1"
      }
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git commit *": "ask",
      "git push": "ask",
      "git push *": "ask",
      "git push --force *": "ask",
      "git rebase *": "ask",
      "git reset --hard *": "ask"
    },
    "read": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/credentials.json": "deny",
      "**/secrets/**": "deny",
      "*.env": "deny",
      "*.env.*": "deny"
    }
  },
  "share": "disabled"
}
